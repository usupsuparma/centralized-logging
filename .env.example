# ==============================================================================
# Centralized Logging Server Configuration (.env)
# Khusus untuk Server Monitoring (Grafana Loki & Grafana Dashboard)
# ==============================================================================

# Grafana Web UI
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Loki Log Storage Engine (Port Ingestion & Query)
LOKI_PORT=3100
